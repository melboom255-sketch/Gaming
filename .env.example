# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Backend Session Signing Secret (Set a strong random secret in AI Studio Secrets)
SESSION_SECRET="change-this-to-a-long-random-secret"

# Supabase Configuration (Add these in AI Studio Secrets; NEVER expose SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY in frontend code)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your-supabase-secret-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your-public-supabase-key"

# Optional Upstash / KV REST API (Alternative persistent backend storage)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
